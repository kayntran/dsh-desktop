{
  "// ": [
    "Type checking only — the real build is produced by build.mjs (esbuild).",
    "",
    "`paths` is the only way TypeScript can see upstream's types: the plugin resolves",
    "modules from its own directory, and there is no copy of @deepseek-ai/* there, nor",
    "should there be. Pointing straight at the type tree inside the installed engine",
    "always matches the engine version actually running.",
    "",
    "The `*` entry covers bare package names; the explicit entries cover the `/client`",
    "subpath, and an explicit entry always beats a `*` pattern, so nothing is ambiguous."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Upstream viết import kèm đuôi `.ts`/`.tsx` và esbuild cũng hiểu, nên giữ
    // cùng lối viết thay vì bỏ đuôi.
    "allowImportingTsExtensions": true,

    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-client-runtime/client": ["../../engine/node_modules/@deepseek-ai/dsh-client-runtime/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-layout/client": ["../../engine/node_modules/@deepseek-ai/dsh-client-ui-layout/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-conversation/client": ["../../engine/node_modules/@deepseek-ai/dsh-client-ui-conversation/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-settings/client": ["../../engine/node_modules/@deepseek-ai/dsh-client-ui-settings/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-tool/client": ["../../engine/node_modules/@deepseek-ai/dsh-client-ui-tool/lib/types/client/index.d.ts"],
      "@deepseek-ai/*": ["../../engine/node_modules/@deepseek-ai/*/lib/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
