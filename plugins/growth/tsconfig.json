{
  "// ": [
    "Type checking only — the real build is produced by build.mjs (esbuild).",
    "",
    "`paths` points straight at the type tree inside the installed engine, for the",
    "same reason as plugins/dock/tsconfig.json: a plugin resolves modules from its",
    "own directory, and there is no copy of @deepseek-ai/* there.",
    "",
    "The `zod` entry is not optional: dsh-storage-domain's own declarations import",
    "`ZodType` from 'zod', so without it the domain spec types degrade to `any` and",
    "the record type stops being inferred."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,

    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-client-runtime/client": ["../../engine/node_modules/@deepseek-ai/dsh-client-runtime/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-settings/client": ["../../engine/node_modules/@deepseek-ai/dsh-client-ui-settings/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-conversation/client": ["../../engine/node_modules/@deepseek-ai/dsh-client-ui-conversation/lib/types/client/index.d.ts"],
      "@deepseek-ai/*": ["../../engine/node_modules/@deepseek-ai/*/lib/types/index.d.ts"],
      "zod": ["../../engine/node_modules/zod/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
